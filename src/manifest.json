{
  "name": "Ninja Ad (Stealth Switch)",
  "description": "Ad blocker with YouTube compatibility: automatically clicks available skip buttons.",
  "version": "11.4",
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["youtube.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "core",
        "enabled": false,
        "path": "rules-core.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["noop.js", "noop.gif", "noop.css", "noop.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
